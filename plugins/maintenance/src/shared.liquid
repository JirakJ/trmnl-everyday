<style>
.everyday-hero { font-family: system-ui, sans-serif; font-size: 48px; font-weight: 700; line-height: 1.05; overflow-wrap: anywhere; }
.everyday-detail { line-height: 1.3; }
.everyday-row { border-bottom: 1px solid black; padding-bottom: 7px; }
.everyday-kicker { text-transform: uppercase; letter-spacing: 1px; font-size: 12px; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('canvas.everyday-qr').forEach(function (canvas) {
    const size = Number(canvas.dataset.size), bits = canvas.dataset.bits;
    if (!Number.isInteger(size) || size < 21 || size > 81 || !/^[0-9a-f]+$/.test(bits)) return;
    const width = Math.ceil(size / 4), scale = Number(canvas.dataset.scale) || 3;
    if (bits.length !== size * width) return;
    canvas.width = canvas.height = size * scale;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#000';
    for (let y = 0; y < size; y++) {
      const row = BigInt('0x' + bits.slice(y * width, (y + 1) * width));
      for (let x = 0; x < size; x++) {
        if ((row >> BigInt(size - 1 - x)) & 1n) ctx.fillRect(x * scale, y * scale, scale, scale);
      }
    }
  });
});
</script>
